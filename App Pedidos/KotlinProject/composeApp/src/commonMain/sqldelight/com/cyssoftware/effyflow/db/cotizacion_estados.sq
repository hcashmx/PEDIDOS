CREATE TABLE cot_estado_sync_session (
 session_id TEXT NOT NULL PRIMARY KEY, user_id INTEGER NOT NULL, agent_id INTEGER NOT NULL,
 device_id TEXT NOT NULL, generation INTEGER NOT NULL, remote_state TEXT NOT NULL,
 bootstrap_state TEXT NOT NULL, last_committed_sequence INTEGER NOT NULL DEFAULT 0,
 last_acked_sequence INTEGER NOT NULL DEFAULT 0, snapshot_end_sequence INTEGER,
 offline_valid_until_utc TEXT, last_server_observed_at_utc TEXT, last_elapsed_observed_ms INTEGER,
 max_observed_wall_utc TEXT, revocation_reason_code TEXT,
 ingestion_suspended INTEGER NOT NULL DEFAULT 0, capacity_code TEXT, last_sync_at_utc TEXT,
 last_error_code TEXT, last_error_message TEXT, created_at_utc TEXT NOT NULL, updated_at_utc TEXT NOT NULL,
 UNIQUE(user_id,agent_id,device_id,generation)
);
CREATE INDEX cot_estado_session_identity_idx ON cot_estado_sync_session(user_id,agent_id,device_id,generation DESC);

CREATE TABLE cot_estado_document (
 session_id TEXT NOT NULL, generation INTEGER NOT NULL, cotizacion_uuid TEXT NOT NULL,
 erp_id INTEGER NOT NULL, version INTEGER NOT NULL, estado TEXT NOT NULL, agent_id INTEGER,
 updated_at_utc TEXT, last_delivery_sequence INTEGER NOT NULL, payload_fingerprint TEXT NOT NULL,
 PRIMARY KEY(session_id,generation,cotizacion_uuid), UNIQUE(session_id,generation,erp_id),
 FOREIGN KEY(session_id) REFERENCES cot_estado_sync_session(session_id) ON DELETE CASCADE
);
CREATE TABLE cot_estado_tombstone (
 session_id TEXT NOT NULL, generation INTEGER NOT NULL, cotizacion_uuid TEXT NOT NULL,
 erp_id INTEGER NOT NULL, version INTEGER NOT NULL, event_id INTEGER, changed_at_utc TEXT,
 last_delivery_sequence INTEGER NOT NULL, payload_fingerprint TEXT NOT NULL,
 PRIMARY KEY(session_id,generation,cotizacion_uuid),
 FOREIGN KEY(session_id) REFERENCES cot_estado_sync_session(session_id) ON DELETE CASCADE
);
CREATE TABLE cot_estado_delivery_receipt (
 session_id TEXT NOT NULL, generation INTEGER NOT NULL, delivery_sequence INTEGER NOT NULL,
 kind TEXT NOT NULL, payload_fingerprint TEXT NOT NULL, applied_at_utc TEXT NOT NULL,
 PRIMARY KEY(session_id,generation,delivery_sequence),
 FOREIGN KEY(session_id) REFERENCES cot_estado_sync_session(session_id) ON DELETE CASCADE
);

findLatestStateSession:
SELECT * FROM cot_estado_sync_session WHERE user_id=? AND agent_id=? AND device_id=? ORDER BY generation DESC LIMIT 1;
findStateSession:
SELECT * FROM cot_estado_sync_session WHERE session_id=? AND generation=?;
findStateSessionById:
SELECT * FROM cot_estado_sync_session WHERE session_id=?;
listStateSessionsForUser:
SELECT * FROM cot_estado_sync_session WHERE user_id=?;
insertStateSession:
INSERT OR IGNORE INTO cot_estado_sync_session VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?);
commitStatePage:
UPDATE cot_estado_sync_session SET last_committed_sequence=?,snapshot_end_sequence=?,bootstrap_state=?,updated_at_utc=?,last_error_code=NULL,last_error_message=NULL WHERE session_id=? AND generation=?;
ackStatePage:
UPDATE cot_estado_sync_session SET last_acked_sequence=?,remote_state=?,bootstrap_state=?,last_sync_at_utc=?,updated_at_utc=?,last_error_code=NULL,last_error_message=NULL WHERE session_id=? AND generation=?;
updateStateRemoteStatus:
UPDATE cot_estado_sync_session SET remote_state=?,bootstrap_state=?,offline_valid_until_utc=?,last_server_observed_at_utc=?,last_elapsed_observed_ms=?,max_observed_wall_utc=?,revocation_reason_code=?,ingestion_suspended=?,capacity_code=?,last_sync_at_utc=?,updated_at_utc=?,last_error_code=NULL,last_error_message=NULL WHERE session_id=? AND generation=?;
markStateError:
UPDATE cot_estado_sync_session SET last_error_code=?,last_error_message=?,updated_at_utc=? WHERE session_id=? AND generation=?;
markStateBlocked:
UPDATE cot_estado_sync_session SET remote_state=?,bootstrap_state=?,offline_valid_until_utc=NULL,revocation_reason_code=?,last_error_code=?,last_error_message=?,updated_at_utc=? WHERE session_id=? AND generation=?;
insertStateDocument:
INSERT OR REPLACE INTO cot_estado_document VALUES (?,?,?,?,?,?,?,?,?,?);
findStateDocument:
SELECT * FROM cot_estado_document WHERE session_id=? AND generation=? AND cotizacion_uuid=?;
listStateDocuments:
SELECT * FROM cot_estado_document WHERE session_id=? AND generation=? ORDER BY updated_at_utc DESC,erp_id DESC;
deleteAllStateDocuments:
DELETE FROM cot_estado_document WHERE session_id=? AND generation=?;
deleteStateDocument:
DELETE FROM cot_estado_document WHERE session_id=? AND generation=? AND cotizacion_uuid=?;
insertStateTombstone:
INSERT OR REPLACE INTO cot_estado_tombstone VALUES (?,?,?,?,?,?,?,?,?);
findStateTombstone:
SELECT * FROM cot_estado_tombstone WHERE session_id=? AND generation=? AND cotizacion_uuid=?;
deleteAllStateTombstones:
DELETE FROM cot_estado_tombstone WHERE session_id=? AND generation=?;
deleteStateTombstone:
DELETE FROM cot_estado_tombstone WHERE session_id=? AND generation=? AND cotizacion_uuid=?;
insertStateReceipt:
INSERT INTO cot_estado_delivery_receipt VALUES (?,?,?,?,?,?);
findStateReceipt:
SELECT * FROM cot_estado_delivery_receipt WHERE session_id=? AND generation=? AND delivery_sequence=?;
deleteAllStateReceipts:
DELETE FROM cot_estado_delivery_receipt WHERE session_id=? AND generation=?;
purgeStateNamespace:
DELETE FROM cot_estado_sync_session WHERE session_id=? AND generation=?;
countStateDocuments:
SELECT COUNT(*) FROM cot_estado_document WHERE session_id=? AND generation=?;
