

CREATE TABLE categorias (
    id_categoria INTEGER NOT NULL PRIMARY KEY,
    nombre_categoria TEXT,
    id_padre INTEGER,
    nivel INTEGER DEFAULT 1,
    activo INTEGER,
    updated_at TEXT
);

selectAll:
SELECT * FROM categorias;

findById:
SELECT * FROM categorias WHERE id_categoria = ?;

insertCategorias:
INSERT OR REPLACE INTO categorias (id_categoria, nombre_categoria, id_padre, nivel, activo, updated_at)
VALUES (?, ?, ?, ?, ?, ?);

updateCategorias:
UPDATE categorias
SET nombre_categoria = ?, id_padre = ?, nivel = ?, activo = ?, updated_at = ?
WHERE id_categoria = ?;

deleteCategorias:
DELETE FROM categorias WHERE id_categoria = ?;


getMaxUpdatedAt: SELECT MAX(updated_at) AS max_updated_at FROM categorias;