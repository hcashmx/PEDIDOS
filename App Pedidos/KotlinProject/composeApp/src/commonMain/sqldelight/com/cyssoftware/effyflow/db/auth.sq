CREATE TABLE OfflineUser (
 userId INTEGER NOT NULL PRIMARY KEY, username TEXT NOT NULL UNIQUE, email TEXT,
 nombre TEXT NOT NULL, roles TEXT NOT NULL, active INTEGER NOT NULL,
 credentialVersion INTEGER NOT NULL, salt TEXT, verifier TEXT, iterations INTEGER, enrolledAt TEXT
);
CREATE TABLE LocalSession (
 id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1), userId INTEGER NOT NULL, authenticatedAt TEXT NOT NULL
);
CREATE TABLE SyncCredentials (
 userId INTEGER NOT NULL PRIMARY KEY, accessToken TEXT NOT NULL, refreshToken TEXT NOT NULL
);

findUser:
SELECT * FROM OfflineUser WHERE username = ?;
findUserById:
SELECT * FROM OfflineUser WHERE userId = ?;
allUsers:
SELECT * FROM OfflineUser ORDER BY username;
insertUser:
INSERT OR IGNORE INTO OfflineUser(userId, username, email, nombre, roles, active, credentialVersion)
VALUES (?, ?, ?, ?, ?, ?, ?);
updateUser:
UPDATE OfflineUser SET username=?, email=?, nombre=?, roles=?, active=?, credentialVersion=? WHERE userId=?;
disableAll:
UPDATE OfflineUser SET active = 0;
invalidateUser:
UPDATE OfflineUser SET salt=NULL, verifier=NULL, iterations=NULL, enrolledAt=NULL WHERE userId = ?;
enrollUser:
UPDATE OfflineUser SET salt=?, verifier=?, iterations=?, enrolledAt=? WHERE userId=?;
openSession:
INSERT OR REPLACE INTO LocalSession(id, userId, authenticatedAt) VALUES (1, ?, ?);
getSession:
SELECT u.userId AS usuarioId, u.username AS email, u.nombre AS usuarioName, u.roles, t.accessToken, t.refreshToken
FROM LocalSession s JOIN OfflineUser u ON u.userId=s.userId
LEFT JOIN SyncCredentials t ON t.userId=u.userId
WHERE s.id=1 AND u.active=1 AND u.verifier IS NOT NULL;
clearSession:
DELETE FROM LocalSession;
saveTokens:
INSERT OR REPLACE INTO SyncCredentials(userId, accessToken, refreshToken) VALUES (?, ?, ?);
getTokens:
SELECT * FROM SyncCredentials WHERE userId = ?;
deleteTokens:
DELETE FROM SyncCredentials WHERE userId = ?;
